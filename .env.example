# 复制为 .env 并填入真实值。.env 已在 .gitignore 中。
#
# 多个服务商的 key 可以同时填在这里并存，靠 LLM_PROVIDER 一行切换，
# 不会串线（每个服务商只认自己的 key 变量）。
#
# ⚠ 系统环境变量优先级高于本文件（load_dotenv 不覆盖已存在的变量）。
#   这台机器的系统环境里已经有 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL /
#   DASHSCOPE_MODEL / DEEPSEEK_API_KEY，在这里改这几个值不会生效。
#   模型连接状态可在工作台查看。

# ---------- LLM 配置（OpenAI 兼容协议）----------
# 可选值：zhipu(=glm) / deepseek / dashscope(=qwen) / openai-compatible
LLM_PROVIDER=zhipu

# 方案一：智谱 GLM —— key 去 https://open.bigmodel.cn/ 申请
ZHIPU_API_KEY=
# 模型名以控制台「模型广场」里的实际 ID 为准，填错会 404。
# 留空则用代码里的默认值 glm-5.3-flash
ZHIPU_MODEL=glm-5.3-flash
# 走海外站点才需要改，例如 https://api.z.ai/api/paas/v4
ZHIPU_BASE_URL=

# 推理模型的思考强度：low / high / max，填 none 表示不发这个参数。
# 留空则用服务商默认（zhipu 默认 low）。
# 注意 GLM-5.3-Flash 无法关闭思考，只能调档；MMM 全是短的结构化调用，low 足够。
LLM_REASONING_EFFORT=

# 方案二：阿里云百炼 / DashScope（同一个 key 既能调 qwen 也能调平台上架的 deepseek）
# key 去 https://bailian.console.aliyun.com/ 申请
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-pro
# 国际区用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 国内区用 https://dashscope.aliyuncs.com/compatible-mode/v1
# 填错区会 401
DASHSCOPE_BASE_URL=

# 方案三：DeepSeek 官方 —— key 去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# LLM_MODEL 留空时该 provider 用自己的默认模型；填了则对所有 provider 强制生效
# LLM_MODEL=deepseek-v4-flash

# 通用覆盖项：填了就压过上面所有 provider 的推断结果，接自定义网关时用
LLM_API_KEY=
LLM_BASE_URL=

# ---------- 当前日历与记忆应用 ----------
# 置 1 停用真实模型调用；手动待办仍可使用，聊天明确报告模型不可用。
MMM_OFFLINE=0
CALENDAR_DB_PATH=./data/calendar.db
# 可选：只读导入旧历史，旧程序已移除。
MMM_DB_PATH=./data/mmm.db
# 个人记忆上下文字符预算（4000–60000）。
MMM_MEMORY_CONTEXT_CHARS=18000
# 回顾启用、小时、合并和补发在首页偏好中保存。
