{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Agent Run · 持久状态与执行阶段",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      1040,
      600
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "执行阶段"
    },
    {
      "id": "waiting",
      "label": "等待与恢复"
    },
    {
      "id": "terminal",
      "label": "终止"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "sublabel": "SQLite 队列",
      "lane": "main",
      "col": 0
    },
    {
      "id": "running",
      "type": "active",
      "label": "Running",
      "sublabel": "组装相关记忆",
      "lane": "main",
      "col": 1
    },
    {
      "id": "decision",
      "type": "decision",
      "label": "Decision",
      "sublabel": "模型选择下一步",
      "lane": "main",
      "col": 2
    },
    {
      "id": "tools",
      "type": "active",
      "label": "Tool / Observe",
      "sublabel": "独立事务与结果",
      "lane": "main",
      "col": 3
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Completed",
      "sublabel": "保存最终回答",
      "lane": "main",
      "col": 4
    },
    {
      "id": "waiting",
      "type": "waiting",
      "label": "Waiting for user",
      "sublabel": "补充后恢复原 Run",
      "lane": "waiting",
      "col": 0
    },
    {
      "id": "failed",
      "type": "neutral",
      "label": "Failed",
      "sublabel": "预算或校验失败",
      "lane": "terminal",
      "col": 1,
      "yOffset": -150
    },
    {
      "id": "cancelled",
      "type": "neutral",
      "label": "Cancelled",
      "sublabel": "用户主动取消",
      "lane": "terminal",
      "col": 2,
      "yOffset": -150
    }
  ],
  "transitions": [
    {
      "from": "decision",
      "to": "waiting",
      "label": "需补充",
      "labelDy": 45,
      "labelDx": -45
    },
    {
      "from": "waiting",
      "to": "decision",
      "label": "恢复",
      "labelDx": 50
    },
    {
      "from": "tools",
      "to": "failed",
      "label": "失败",
      "labelDy": 45
    },
    {
      "from": "tools",
      "to": "cancelled",
      "label": "用户取消",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "运行语义",
      "items": [
        "Decision 与 Tool 是 running 内部阶段，可循环",
        "服务重启将中断 Run 转为等待确认；断线不取消"
      ]
    }
  ]
}